{% comment %}
  Spellbinder — Formulator Story
  sections/sb-formulator.liquid

  Two-column: image left, copy right. Compton Rom feature.
{% endcomment %}

<section
  class="sb-formulator"
  id="sb-formulator-{{ section.id }}"
>
  <div class="sb-formulator__grid">
    <div class="sb-formulator__image-col">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1000
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000',
            sizes: '(max-width: 749px) 100vw, 50vw',
            class: 'sb-formulator__img',
            alt: section.settings.image.alt | default: 'Compton Rom, Microbiologist & Founder' | escape
        }}
      {%- else -%}
        <div class="sb-formulator__img-placeholder">
          {{ 'image' | placeholder_svg_tag: 'sb-formulator__img' }}
        </div>
      {%- endif -%}
    </div>

    <div class="sb-formulator__copy-col">
      {%- unless section.settings.eyebrow == blank -%}
        <p class="sb-formulator__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endunless -%}

      {%- unless section.settings.heading == blank -%}
        <h2 class="sb-formulator__heading sb-headline-lg">{{ section.settings.heading }}</h2>
      {%- endunless -%}

      {%- unless section.settings.body == blank -%}
        <div class="sb-formulator__body sb-body">{{ section.settings.body }}</div>
      {%- endunless -%}

      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a href="{{ section.settings.cta_url }}" class="sb-btn sb-formulator__cta">
          {{ section.settings.cta_label }}
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

<style>
  #sb-formulator-{{ section.id }} {
    background: var(--sb-smoke);
    padding: var(--sb-space-9) var(--sb-space-9);
  }

  #sb-formulator-{{ section.id }} .sb-formulator__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sb-space-8);
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }

  #sb-formulator-{{ section.id }} .sb-formulator__img {
    width: 100%;
    height: auto;
    border-radius: var(--sb-radius-md);
    display: block;
    aspect-ratio: 4/5;
    object-fit: cover;
  }

  #sb-formulator-{{ section.id }} .sb-formulator__img-placeholder {
    background: var(--sb-smoke-light);
    border-radius: var(--sb-radius-md);
    aspect-ratio: 4/5;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #sb-formulator-{{ section.id }} .sb-formulator__img-placeholder svg {
    width: 60%;
    opacity: 0.2;
  }

  #sb-formulator-{{ section.id }} .sb-formulator__eyebrow {
    font-family: var(--sb-font-ui);
    font-size: 13px;
    font-weight: var(--sb-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sb-gold);
    margin: 0 0 var(--sb-space-4);
  }

  #sb-formulator-{{ section.id }} .sb-formulator__heading {
    margin: 0 0 var(--sb-space-5);
  }

  #sb-formulator-{{ section.id }} .sb-formulator__body {
    margin: 0 0 var(--sb-space-5);
  }

  #sb-formulator-{{ section.id }} .sb-formulator__body p {
    margin: 0 0 var(--sb-space-4);
  }

  #sb-formulator-{{ section.id }} .sb-formulator__body p:last-child {
    margin-bottom: 0;
  }

  @media screen and (max-width: 749px) {
    #sb-formulator-{{ section.id }} {
      padding: var(--sb-space-8) var(--sb-space-5);
    }

    #sb-formulator-{{ section.id }} .sb-formulator__grid {
      grid-template-columns: 1fr;
      gap: var(--sb-space-6);
    }
  }
</style>

{% schema %}
{
  "name": "SB Formulator",
  "tag": "section",
  "class": "spellbinder-formulator",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE FORMULATOR"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Where science becomes alchemy."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Every ingredient in Spellbinder is prayerfully curated by Compton Rom \u2014 a microbiologist who spent years at the crossroads of ancient Eastern herbalism and Western biochemistry, asking one question: what does the body actually need?</p><p>His answer was a system built on spagyric extraction \u2014 an ancient alchemical process that captures the full spectrum of each plant. Remove. Replenish. Regenerate. Not a tagline. A biological protocol, built into every dose.</p>"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Read Compton's story \u2192"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ],
  "presets": [
    {
      "name": "SB Formulator"
    }
  ]
}
{% endschema %}
