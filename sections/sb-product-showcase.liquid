{% comment %}
  Spellbinder — Product Showcase
  sections/sb-product-showcase.liquid

  Two product cards + bundle bar. Pulls live product data with override option.
{% endcomment %}

<section
  class="sb-product-showcase"
  id="sb-product-showcase-{{ section.id }}"
>
  <div class="sb-product-showcase__inner">
    {%- unless section.settings.eyebrow == blank -%}
      <p class="sb-product-showcase__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endunless -%}

    {%- unless section.settings.heading == blank -%}
      <h2 class="sb-product-showcase__heading sb-headline-lg">{{ section.settings.heading }}</h2>
    {%- endunless -%}

    <div class="sb-product-showcase__grid">
      {%- for block in section.blocks -%}
        {%- if block.type == 'product_card' -%}
          {%- assign prod = block.settings.product -%}
          <div class="sb-product-showcase__card sb-card" {{ block.shopify_attributes }}>
            {%- unless block.settings.tag == blank -%}
              <p class="sb-product-showcase__tag">{{ block.settings.tag }}</p>
            {%- endunless -%}

            {%- if prod != blank -%}
              <a href="{{ prod.url }}" class="sb-product-showcase__img-link">
                {{
                  prod.featured_image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 400, 600, 800',
                    sizes: '(max-width: 749px) 90vw, 400px',
                    class: 'sb-product-showcase__img',
                    alt: prod.featured_image.alt | default: prod.title | escape
                }}
              </a>
              <h3 class="sb-product-showcase__product-title">{{ prod.title }}</h3>
            {%- else -%}
              <div class="sb-product-showcase__img-placeholder">
                {{ 'product-1' | placeholder_svg_tag: 'sb-product-showcase__img' }}
              </div>
              <h3 class="sb-product-showcase__product-title">{{ block.settings.title_override | default: 'Product Name' }}</h3>
            {%- endif -%}

            {%- unless block.settings.description == blank -%}
              <p class="sb-product-showcase__desc sb-body">{{ block.settings.description }}</p>
            {%- endunless -%}

            <div class="sb-product-showcase__pricing">
              {%- unless block.settings.price_text == blank -%}
                <p class="sb-product-showcase__price">{{ block.settings.price_text }}</p>
              {%- endunless -%}
              {%- unless block.settings.subscribe_text == blank -%}
                <p class="sb-product-showcase__subscribe">{{ block.settings.subscribe_text }}</p>
              {%- endunless -%}
            </div>

            {%- if block.settings.cta_label != blank -%}
              <a href="{{ prod.url | default: block.settings.cta_url }}" class="sb-btn sb-product-showcase__cta">
                {{ block.settings.cta_label }}
              </a>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.bundle_text != blank -%}
      <div class="sb-product-showcase__bundle">
        <a href="{{ section.settings.bundle_url }}" class="sb-product-showcase__bundle-link">
          {{ section.settings.bundle_text }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #sb-product-showcase-{{ section.id }} {
    background: var(--sb-black);
    padding: var(--sb-space-9) var(--sb-space-9);
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__eyebrow {
    font-family: var(--sb-font-ui);
    font-size: 13px;
    font-weight: var(--sb-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sb-gold);
    margin: 0 0 var(--sb-space-4);
    text-align: center;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__heading {
    margin: 0 0 var(--sb-space-7);
    text-align: center;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--sb-space-6);
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__card {
    display: flex;
    flex-direction: column;
    gap: var(--sb-space-4);
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__tag {
    font-family: var(--sb-font-ui);
    font-size: 12px;
    font-weight: var(--sb-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sb-gold);
    margin: 0;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__img-link {
    display: block;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__img {
    width: 100%;
    height: auto;
    border-radius: var(--sb-radius-sm);
    display: block;
    aspect-ratio: 1/1;
    object-fit: cover;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__img-placeholder {
    background: var(--sb-smoke-light);
    border-radius: var(--sb-radius-sm);
    aspect-ratio: 1/1;
    overflow: hidden;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__img-placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__product-title {
    font-family: var(--sb-font-display);
    font-size: clamp(24px, 2vw, 30px);
    color: var(--sb-text-primary);
    margin: 0;
    line-height: var(--sb-leading-tight);
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__desc {
    margin: 0;
    flex: 1;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__pricing {
    display: flex;
    flex-direction: column;
    gap: var(--sb-space-1);
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__price {
    font-family: var(--sb-font-ui);
    font-size: var(--sb-text-ui-md);
    font-weight: var(--sb-weight-bold);
    color: var(--sb-text-primary);
    margin: 0;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__subscribe {
    font-family: var(--sb-font-ui);
    font-size: 14px;
    color: var(--sb-gold-light);
    margin: 0;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__cta {
    align-self: flex-start;
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__bundle {
    margin-top: var(--sb-space-7);
    text-align: center;
    padding: var(--sb-space-5);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-radius-md);
    background: var(--sb-smoke);
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__bundle-link {
    font-family: var(--sb-font-ui);
    font-size: var(--sb-text-ui-md);
    font-weight: var(--sb-weight-bold);
    color: var(--sb-gold);
    text-decoration: none;
    transition: color var(--sb-transition);
  }

  #sb-product-showcase-{{ section.id }} .sb-product-showcase__bundle-link:hover {
    color: var(--sb-gold-light);
  }

  @media screen and (max-width: 749px) {
    #sb-product-showcase-{{ section.id }} {
      padding: var(--sb-space-8) var(--sb-space-5);
    }

    #sb-product-showcase-{{ section.id }} .sb-product-showcase__grid {
      grid-template-columns: 1fr;
    }
  }
</style>

{% schema %}
{
  "name": "SB Product Showcase",
  "tag": "section",
  "class": "spellbinder-product-showcase",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CHOOSE YOUR RITUAL"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Two elixirs. One complete system."
    },
    {
      "type": "text",
      "id": "bundle_text",
      "label": "Bundle bar text",
      "default": "Complete the system \u2014 Save 20% on the Ritual Bundle \u2192"
    },
    {
      "type": "url",
      "id": "bundle_url",
      "label": "Bundle bar URL"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "limit": 3,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "text",
          "id": "title_override",
          "label": "Title override (if no product selected)"
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag (above image)",
          "default": "FLAGSHIP FORMULA"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description override"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price text",
          "default": "$50 \u00b7 30 servings"
        },
        {
          "type": "text",
          "id": "subscribe_text",
          "label": "Subscribe price text",
          "default": "$42 \u00b7 save 16% \u00b7 cancel anytime"
        },
        {
          "type": "text",
          "id": "cta_label",
          "label": "CTA label",
          "default": "Begin Your Ritual"
        },
        {
          "type": "url",
          "id": "cta_url",
          "label": "CTA URL (fallback if no product)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SB Product Showcase",
      "blocks": [
        {
          "type": "product_card",
          "settings": {
            "tag": "FLAGSHIP FORMULA",
            "description": "Forty-plus prayerfully curated ingredients \u2014 spagyric adaptogens, medicinal mushrooms, ancient longevity herbs, and algae superfoods. Microbiologist-formulated by Compton Rom. Nothing wasted.",
            "price_text": "$50 \u00b7 30 servings",
            "subscribe_text": "$42 \u00b7 save 16% \u00b7 cancel anytime",
            "cta_label": "Begin Your Ritual \u2192"
          }
        },
        {
          "type": "product_card",
          "settings": {
            "tag": "FAN FAVOURITE",
            "description": "Warming. Rich. Restorative. Turmeric, ginger, eight medicinal mushrooms, and aromatic spices. Caffeine-free. Hot or iced. The ritual that repairs you while you enjoy it.",
            "price_text": "$50 \u00b7 30 servings",
            "subscribe_text": "$42 \u00b7 save 16% \u00b7 cancel anytime",
            "cta_label": "Discover Yours \u2192"
          }
        }
      ]
    }
  ]
}
{% endschema %}
