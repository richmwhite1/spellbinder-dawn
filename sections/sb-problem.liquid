{% comment %}
  Spellbinder — The Problem
  sections/sb-problem.liquid

  Two-column: image left, copy right. Sets up the pain point.
{% endcomment %}

<section
  class="sb-problem"
  id="sb-problem-{{ section.id }}"
>
  <div class="sb-problem__grid">
    <div class="sb-problem__image-col">
      {%- if section.settings.image != blank -%}
        {{
          section.settings.image
          | image_url: width: 1200
          | image_tag:
            loading: 'lazy',
            widths: '400, 600, 800, 1000, 1200',
            sizes: '(max-width: 749px) 100vw, 50vw',
            class: 'sb-problem__img',
            alt: section.settings.image.alt | default: 'Contemplative morning scene' | escape
        }}
      {%- else -%}
        <div class="sb-problem__img-placeholder">
          {{ 'lifestyle-2' | placeholder_svg_tag: 'sb-problem__img' }}
        </div>
      {%- endif -%}
    </div>

    <div class="sb-problem__copy-col">
      {%- unless section.settings.eyebrow == blank -%}
        <p class="sb-problem__eyebrow">{{ section.settings.eyebrow }}</p>
      {%- endunless -%}

      {%- unless section.settings.heading == blank -%}
        <h2 class="sb-problem__heading sb-headline-lg">{{ section.settings.heading }}</h2>
      {%- endunless -%}

      {%- unless section.settings.body == blank -%}
        <div class="sb-problem__body sb-body">{{ section.settings.body }}</div>
      {%- endunless -%}

      {%- unless section.settings.closing_line == blank -%}
        <p class="sb-problem__closing">{{ section.settings.closing_line }}</p>
      {%- endunless -%}
    </div>
  </div>
</section>

<style>
  #sb-problem-{{ section.id }} {
    background: var(--sb-black);
    padding: var(--sb-space-9) var(--sb-space-9);
  }

  #sb-problem-{{ section.id }} .sb-problem__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sb-space-8);
    max-width: 1200px;
    margin: 0 auto;
    align-items: center;
  }

  #sb-problem-{{ section.id }} .sb-problem__img {
    width: 100%;
    height: auto;
    border-radius: var(--sb-radius-md);
    display: block;
    aspect-ratio: 4/5;
    object-fit: cover;
  }

  #sb-problem-{{ section.id }} .sb-problem__img-placeholder {
    background: var(--sb-smoke);
    border-radius: var(--sb-radius-md);
    aspect-ratio: 4/5;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }

  #sb-problem-{{ section.id }} .sb-problem__img-placeholder svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  #sb-problem-{{ section.id }} .sb-problem__eyebrow {
    font-family: var(--sb-font-ui);
    font-size: 13px;
    font-weight: var(--sb-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sb-gold);
    margin: 0 0 var(--sb-space-4);
  }

  #sb-problem-{{ section.id }} .sb-problem__heading {
    margin: 0 0 var(--sb-space-5);
  }

  #sb-problem-{{ section.id }} .sb-problem__body {
    margin: 0 0 var(--sb-space-5);
  }

  #sb-problem-{{ section.id }} .sb-problem__body p {
    margin: 0 0 var(--sb-space-4);
  }

  #sb-problem-{{ section.id }} .sb-problem__body p:last-child {
    margin-bottom: 0;
  }

  #sb-problem-{{ section.id }} .sb-problem__closing {
    font-family: var(--sb-font-display);
    font-size: clamp(20px, 2vw, var(--sb-text-ui-xl));
    font-style: italic;
    color: var(--sb-gold-light);
    line-height: var(--sb-leading-body);
    margin: var(--sb-space-5) 0 0;
  }

  @media screen and (max-width: 749px) {
    #sb-problem-{{ section.id }} {
      padding: var(--sb-space-8) var(--sb-space-5);
    }

    #sb-problem-{{ section.id }} .sb-problem__grid {
      grid-template-columns: 1fr;
      gap: var(--sb-space-6);
    }
  }
</style>

{% schema %}
{
  "name": "SB Problem",
  "tag": "section",
  "class": "spellbinder-problem",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "THE MORNING TRAP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your morning is working against you."
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>Most of us start the day the same way. A cup of coffee. Maybe two. A jolt of cortisol, a spike in blood sugar, and three hours later — the crash.</p><p>Energy drinks promise more and deliver less. Wellness teas are under-dosed or taste like lawn clippings. Supplement stacks feel like a medical protocol. And most of what's marketed as \"healthy\" hides behind seed oils, gum fillers, and proprietary blends that tell you nothing.</p>"
    },
    {
      "type": "text",
      "id": "closing_line",
      "label": "Closing line (italic, accent)",
      "default": "You deserve a little magic in your morning."
    }
  ],
  "presets": [
    {
      "name": "SB Problem"
    }
  ]
}
{% endschema %}
