{% comment %}
  Spellbinder — Comparison Table
  sections/sb-comparison.liquid

  Responsive table comparing Awaken Brew to alternatives.
  Mobile: collapses to stacked cards.
{% endcomment %}

<section
  class="sb-comparison"
  id="sb-comparison-{{ section.id }}"
>
  <div class="sb-comparison__inner">
    {%- unless section.settings.eyebrow == blank -%}
      <p class="sb-comparison__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endunless -%}

    {%- unless section.settings.heading == blank -%}
      <h2 class="sb-comparison__heading sb-headline-lg">{{ section.settings.heading }}</h2>
    {%- endunless -%}

    {%- unless section.settings.subheading == blank -%}
      <p class="sb-comparison__subheading sb-body-lede">{{ section.settings.subheading }}</p>
    {%- endunless -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sb-comparison__table-wrap">
        <table class="sb-comparison__table" role="table">
          <thead>
            <tr>
              <th scope="col">Drink</th>
              <th scope="col">What You Get</th>
              <th scope="col">The Cost</th>
              <th scope="col">Long-Term Effect</th>
            </tr>
          </thead>
          <tbody>
            {%- for block in section.blocks -%}
              {%- if block.type == 'row' -%}
                <tr class="{% if block.settings.highlighted %}sb-comparison__row--highlight{% endif %}" {{ block.shopify_attributes }}>
                  <td data-label="Drink">{{ block.settings.drink }}</td>
                  <td data-label="What You Get">{{ block.settings.benefit }}</td>
                  <td data-label="The Cost">{{ block.settings.cost }}</td>
                  <td data-label="Long-Term">{{ block.settings.longterm }}</td>
                </tr>
              {%- endif -%}
            {%- endfor -%}
          </tbody>
        </table>
      </div>

      {%- comment %} Mobile: stacked cards {% endcomment %}
      <div class="sb-comparison__cards">
        {%- for block in section.blocks -%}
          {%- if block.type == 'row' -%}
            <div class="sb-comparison__card {% if block.settings.highlighted %}sb-comparison__card--highlight{% endif %}" {{ block.shopify_attributes }}>
              <p class="sb-comparison__card-drink">{{ block.settings.drink }}</p>
              <dl class="sb-comparison__card-dl">
                <dt>What You Get</dt>
                <dd>{{ block.settings.benefit }}</dd>
                <dt>The Cost</dt>
                <dd>{{ block.settings.cost }}</dd>
                <dt>Long-Term Effect</dt>
                <dd>{{ block.settings.longterm }}</dd>
              </dl>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
      <div class="sb-comparison__cta-wrap">
        <a href="{{ section.settings.cta_url }}" class="sb-btn">{{ section.settings.cta_label }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

<style>
  #sb-comparison-{{ section.id }} {
    background: var(--sb-black);
    padding: var(--sb-space-9) var(--sb-space-9);
  }

  #sb-comparison-{{ section.id }} .sb-comparison__inner {
    max-width: 1200px;
    margin: 0 auto;
  }

  #sb-comparison-{{ section.id }} .sb-comparison__eyebrow {
    font-family: var(--sb-font-ui);
    font-size: 13px;
    font-weight: var(--sb-weight-bold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sb-gold);
    margin: 0 0 var(--sb-space-4);
  }

  #sb-comparison-{{ section.id }} .sb-comparison__heading {
    margin: 0 0 var(--sb-space-4);
  }

  #sb-comparison-{{ section.id }} .sb-comparison__subheading {
    margin: 0 0 var(--sb-space-7);
    max-width: 700px;
  }

  /* Desktop table */
  #sb-comparison-{{ section.id }} .sb-comparison__table-wrap {
    overflow-x: auto;
  }

  #sb-comparison-{{ section.id }} .sb-comparison__table {
    width: 100%;
    border-collapse: collapse;
    font-family: var(--sb-font-ui);
  }

  #sb-comparison-{{ section.id }} .sb-comparison__table thead th {
    font-size: 13px;
    font-weight: var(--sb-weight-bold);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sb-grey-light);
    text-align: left;
    padding: var(--sb-space-4) var(--sb-space-5);
    border-bottom: 1px solid var(--sb-smoke-lightest);
  }

  #sb-comparison-{{ section.id }} .sb-comparison__table tbody td {
    font-size: var(--sb-text-ui-sm);
    color: var(--sb-text-muted);
    padding: var(--sb-space-4) var(--sb-space-5);
    border-bottom: 1px solid var(--sb-smoke);
    vertical-align: top;
  }

  #sb-comparison-{{ section.id }} .sb-comparison__table tbody td:first-child {
    font-weight: var(--sb-weight-bold);
    color: var(--sb-text-secondary);
  }

  #sb-comparison-{{ section.id }} .sb-comparison__row--highlight {
    background: var(--sb-smoke);
    border: 2px solid var(--sb-gold);
    border-radius: var(--sb-radius-sm);
  }

  #sb-comparison-{{ section.id }} .sb-comparison__row--highlight td {
    color: var(--sb-text-primary);
    border-bottom-color: transparent;
  }

  #sb-comparison-{{ section.id }} .sb-comparison__row--highlight td:first-child {
    color: var(--sb-gold);
  }

  /* Mobile cards — hidden on desktop */
  #sb-comparison-{{ section.id }} .sb-comparison__cards {
    display: none;
  }

  #sb-comparison-{{ section.id }} .sb-comparison__cta-wrap {
    margin-top: var(--sb-space-7);
    text-align: center;
  }

  @media screen and (max-width: 749px) {
    #sb-comparison-{{ section.id }} {
      padding: var(--sb-space-8) var(--sb-space-5);
    }

    #sb-comparison-{{ section.id }} .sb-comparison__table-wrap {
      display: none;
    }

    #sb-comparison-{{ section.id }} .sb-comparison__cards {
      display: flex;
      flex-direction: column;
      gap: var(--sb-space-4);
    }

    #sb-comparison-{{ section.id }} .sb-comparison__card {
      background: var(--sb-smoke);
      border: 1px solid var(--sb-border);
      border-radius: var(--sb-radius-md);
      padding: var(--sb-space-5);
    }

    #sb-comparison-{{ section.id }} .sb-comparison__card--highlight {
      border: 2px solid var(--sb-gold);
    }

    #sb-comparison-{{ section.id }} .sb-comparison__card-drink {
      font-family: var(--sb-font-ui);
      font-size: var(--sb-text-ui-md);
      font-weight: var(--sb-weight-bold);
      color: var(--sb-text-primary);
      margin: 0 0 var(--sb-space-3);
    }

    #sb-comparison-{{ section.id }} .sb-comparison__card--highlight .sb-comparison__card-drink {
      color: var(--sb-gold);
    }

    #sb-comparison-{{ section.id }} .sb-comparison__card-dl {
      margin: 0;
      display: grid;
      grid-template-columns: auto 1fr;
      gap: var(--sb-space-2) var(--sb-space-4);
    }

    #sb-comparison-{{ section.id }} .sb-comparison__card-dl dt {
      font-family: var(--sb-font-ui);
      font-size: 13px;
      font-weight: var(--sb-weight-bold);
      color: var(--sb-grey-light);
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }

    #sb-comparison-{{ section.id }} .sb-comparison__card-dl dd {
      font-family: var(--sb-font-ui);
      font-size: var(--sb-text-ui-sm);
      color: var(--sb-text-muted);
      margin: 0;
    }
  }
</style>

{% schema %}
{
  "name": "SB Comparison",
  "tag": "section",
  "class": "spellbinder-comparison",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY SPELLBINDER"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Don't just start your day. Awaken the wizard within."
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "While others use synthetic vitamins and proprietary blends, we use whole-plant spagyric extracts and 50+ synergistic ingredients. No fillers. No junk. Just magic."
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label",
      "default": "Try Awaken Brew"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    }
  ],
  "blocks": [
    {
      "type": "row",
      "name": "Comparison row",
      "limit": 8,
      "settings": [
        {
          "type": "text",
          "id": "drink",
          "label": "Drink name",
          "default": "Coffee (2–3 cups)"
        },
        {
          "type": "text",
          "id": "benefit",
          "label": "What you get",
          "default": "Fast energy then crash"
        },
        {
          "type": "text",
          "id": "cost",
          "label": "The cost",
          "default": "Cortisol spike, blood sugar swing"
        },
        {
          "type": "text",
          "id": "longterm",
          "label": "Long-term effect",
          "default": "Adrenal stress over time"
        },
        {
          "type": "checkbox",
          "id": "highlighted",
          "label": "Highlight this row (brand row)",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "SB Comparison",
      "blocks": [
        { "type": "row", "settings": { "drink": "Coffee (2\u20133 cups)", "benefit": "Fast energy then crash", "cost": "Cortisol spike, blood sugar swing", "longterm": "Adrenal stress over time", "highlighted": false } },
        { "type": "row", "settings": { "drink": "Energy Drinks", "benefit": "Quick stimulation", "cost": "Artificial ingredients, chronic inflammation", "longterm": "Metabolic disruption", "highlighted": false } },
        { "type": "row", "settings": { "drink": "Standard Wellness Tea", "benefit": "Mild comfort, vague benefits", "cost": "Under-dosed, often sweetened", "longterm": "Little meaningful change", "highlighted": false } },
        { "type": "row", "settings": { "drink": "Popular All-in-Ones", "benefit": "Broad-spectrum coverage", "cost": "Premium price, conventional extraction", "longterm": "Maintenance without depth", "highlighted": false } },
        { "type": "row", "settings": { "drink": "Awaken Brew", "benefit": "Sustained energy, cellular nourishment", "cost": "Zero junk \u2014 spagyric-extracted, clean by design", "longterm": "Biological intelligence compounding daily", "highlighted": true } }
      ]
    }
  ]
}
{% endschema %}
